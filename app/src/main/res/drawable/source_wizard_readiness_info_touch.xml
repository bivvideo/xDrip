<?xml version="1.0" encoding="utf-8"?>
<!-- The target is 48 x 48dp; the visible circle remains 32dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="8dp" android:top="8dp"
                  android:right="8dp" android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="#28FFFFFF"/>
                    <stroke android:width="1dp" android:color="#ACB3B9"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="8dp" android:top="8dp"
                  android:right="8dp" android:bottom="8dp"
                  android:drawable="@drawable/source_wizard_readiness_info"/>
        </layer-list>
    </item>
</selector>
