<?xml version="1.0" encoding="utf-8"?>
<!-- The target is 48dp high, while the drawn Fix button stays 34dp high. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="7dp" android:bottom="7dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30FFFFFF"/>
                    <stroke android:width="1dp" android:color="#88FFFFFF"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="7dp" android:bottom="7dp"
                android:drawable="@drawable/source_wizard_readiness_action"/>
        </layer-list>
    </item>
</selector>
