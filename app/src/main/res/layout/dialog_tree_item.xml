<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="item"
            type="com.eveningoutpost.dexdrip.utilitymodels.SourceWizard.Item" />
    </data>

    <!-- Holo gradient remains visible. Expanded rows share one translucent
         plate and use inset dividers instead of inner rounded cards. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Non-clickable category labels are secondary, uppercase and separated
             by whitespace, not by competing thick divider bars. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="@{item.sectionTopPadding}"
            android:paddingBottom="8dp"
            android:text="@{item.displayTitle}"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="14sp"
            android:letterSpacing="0.045"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="@{item.section ? View.VISIBLE : View.GONE}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="0dp"
            app:sourceWizardPlate="@{item}"
            android:visibility="@{item.section ? View.GONE : View.VISIBLE}"
            android:orientation="vertical">

            <!-- The first separator starts at the parent label (12 + 40 + 14dp).
                 It separates the expanded parent from its children. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.7dp"

                android:background="@color/source_wizard_row_divider"
                android:visibility="@{item.firstNested ? View.VISIBLE : View.GONE}" />

            <!-- Subsequent dividers follow the text at (22 + 48 + 14dp)
                 for icon rows; auxiliary headers use the smaller inset. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.7dp"
                android:layout_marginStart="76dp"
                app:sourceWizardDividerInset="@{item.nestedDividerInset}"
                android:layout_marginEnd="12dp"
                android:background="@color/source_wizard_nested_divider"
                android:visibility="@{item.innerNested ? View.VISIBLE : View.GONE}" />

            <!-- No separately shaded or rounded child rows. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sourceWizardRowMinHeight="@{item.plateMinHeight}"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@{item.plateRowStartPadding}"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:onClick="@{item::onClick}">

            <!-- One 48dp icon slot for every regular leaf. A blank title or
                 a nested auxiliary heading never reserves this space. -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:visibility="@{item.iconVisible ? View.VISIBLE : View.GONE}">

                <!-- Only dark Eversense sensor artwork needs a light local backing. -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/source_wizard_icon_light_plate"
                    android:visibility="@{item.lightIconPlateVisible ? View.VISIBLE : View.GONE}" />

                <!-- A dedicated white backing keeps the dark MiniMed pump legible. -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/source_wizard_icon_light_plate"
                    android:backgroundTint="#FFFFFF"
                    android:visibility="@{item.whiteIconPlateVisible ? View.VISIBLE : View.GONE}" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:scaleX="@{item.deviceIconScale}"
                    android:scaleY="@{item.deviceIconScale}"
                    app:src="@{item.resource}"
                    android:importantForAccessibility="no"
                    android:visibility="@{item.deviceIconVisible ? View.VISIBLE : View.GONE}" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher"
                    android:tint="?android:attr/textColorSecondary"
                    android:alpha="0.14"
                    android:importantForAccessibility="no"
                    android:visibility="@{item.placeholderIconVisible ? View.VISIBLE : View.GONE}" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Each text role is styled globally. GONE roles do not
                     reserve height or margins inside the row. -->
                <TextView
                    style="@style/SourceWizardGroupTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.displayTitle}"
                    android:visibility="@{(item.group || item.readinessAction) &amp;&amp; !item.modelGroup &amp;&amp; !item.auxiliaryTitle ? View.VISIBLE : View.GONE}" />

                <TextView
                    style="@style/SourceWizardSensorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.displayTitle}"
                    android:visibility="@{item.modelGroup || (!item.group &amp;&amp; !item.compactRoute &amp;&amp; !item.readinessAction &amp;&amp; !item.auxiliaryTitle &amp;&amp; !item.informationText &amp;&amp; !item.callToAction) ? View.VISIBLE : View.GONE}" />

                <!-- The fallback question is intentionally the first, prominent line. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.name}"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="@{item.informationText ? View.VISIBLE : View.GONE}" />

                <!-- One white explanation; multiline body is not a gray route. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@{item.informationBody}"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="@{item.informationText ? View.VISIBLE : View.GONE}" />

                <!-- Broadcast-only, muted examples; other information rows keep the original body. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="@{item.broadcastInformation ? View.VISIBLE : View.GONE}">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/source_wizard_broadcast_examples_heading"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/source_wizard_broadcast_juggluco_name"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/source_wizard_broadcast_juggluco_step"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/source_wizard_broadcast_esel_name"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/source_wizard_broadcast_esel_step"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/source_wizard_broadcast_conclusion"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="@{item.broadcastInformation ? View.VISIBLE : View.GONE}" />

                <!-- One explicit call to action after the explanation and divider. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.displayTitle}"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="@{item.callToAction ? View.VISIBLE : View.GONE}" />

                <!-- Auxiliary actions stay clickable but use the same quiet Route typography. -->
                <TextView
                    style="@style/SourceWizardRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.displayTitle}"
                    android:visibility="@{item.auxiliaryTitle ? View.VISIBLE : View.GONE}" />

                <TextView
                    style="@style/SourceWizardRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{item.compactRoute ? item.displayTitle : item.displayRoute}"
                    android:visibility="@{item.compactRoute || item.routeVisible ? View.VISIBLE : View.GONE}" />

                <TextView
                    style="@style/SourceWizardTechnicalHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{item.displaySummary}"
                    android:visibility="@{item.summaryVisible ? View.VISIBLE : View.GONE}" />

            </LinearLayout>

            <!-- Single Holo-tinted vector, rotated right/down for collapsed/expanded groups. -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/source_wizard_chevron"
                android:tint="?android:attr/textColorSecondary"
                android:rotation="@{item.expanded ? 90f : 0f}"
                android:visibility="@{item.navigationChevronVisible ? View.VISIBLE : View.GONE}"
                android:importantForAccessibility="no" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
