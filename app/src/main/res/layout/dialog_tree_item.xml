<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="item"
            type="com.eveningoutpost.dexdrip.utilitymodels.SourceWizard.Item" />
    </data>

    <!-- Category labels stay directly on the Holo gradient. Each source uses
         a translucent plate; expanded parents and children join edge-to-edge. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Non-clickable category labels are secondary, uppercase and separated
             by whitespace, not by competing thick divider bars. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="@{item.sectionTopPadding}"
            android:paddingBottom="8dp"
            android:text="@{item.displayTitle}"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="14sp"
            android:letterSpacing="0.045"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="@{item.section ? View.VISIBLE : View.GONE}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="0dp"
            app:sourceWizardPlate="@{item}"
            android:visibility="@{item.section ? View.GONE : View.VISIBLE}"
            android:orientation="vertical">

            <!-- Nested rows are lighter insets inside the same group plate. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="62dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                app:sourceWizardInner="@{item}"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@{item.plateRowStartPadding}"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:onClick="@{item::onClick}">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:scaleType="fitCenter"
                android:background="@drawable/source_wizard_icon_soft_frame"
                android:clipToOutline="true"
                app:src="@{item.resource}" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{item.displayTitle}"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{item.displaySummary}"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="@{item.summaryVisible ? View.VISIBLE : View.GONE}" />

            </LinearLayout>

            <!-- Single Holo-tinted vector, rotated right/down for collapsed/expanded groups. -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/source_wizard_chevron"
                android:tint="?android:attr/textColorSecondary"
                android:rotation="@{item.expanded ? 90f : 0f}"
                android:visibility="@{item.group ? View.VISIBLE : View.GONE}"
                android:importantForAccessibility="no" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
