<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable visual check row; no permission/collector logic in the layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/readinessRowStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/readinessRowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="6dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/readinessRowFix"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/source_wizard_readiness_fix"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@drawable/source_wizard_readiness_action"
            android:contentDescription="@string/source_wizard_readiness_fix"
            android:visibility="gone" />

        <TextView
            android:id="@+id/readinessRowInfo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="i"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary"
            android:background="@drawable/source_wizard_readiness_info"
            android:contentDescription="@string/source_wizard_readiness_info"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/readinessRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="12dp"
        android:background="@color/source_wizard_nested_divider" />
</LinearLayout>
