<?xml version="1.0" encoding="utf-8"?>
<!-- SW-011: confirmation plus static visual guide to the permanent drawer entry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:text="@string/source_wizard_finish_title"
        android:textSize="22sp"
        android:textColor="?android:attr/textColorPrimary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/source_wizard_row_divider" />

    <ScrollView
        android:id="@+id/finishBodyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/source_wizard_finish_ready_title"
                android:textSize="19sp"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/finishMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/source_wizard_finish_message"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/source_wizard_finish_menu_hint"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Static mini-drawer, intentionally non-clickable and always expanded. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/source_wizard_plate_single"
                android:orientation="vertical"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <LinearLayout
                        android:layout_width="20dp"
                        android:layout_height="19dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="?android:attr/textColorPrimary" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="?android:attr/textColorPrimary" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="?android:attr/textColorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/source_wizard_finish_mini_menu_title"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/source_wizard_row_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center_vertical"
                    android:paddingStart="47dp"
                    android:paddingEnd="12dp"
                    android:text="@string/home_screen"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/source_wizard_row_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:gravity="center_vertical"
                    android:paddingStart="47dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/source_wizard_drawer_entry"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/source_wizard_row_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center_vertical"
                    android:paddingStart="47dp"
                    android:paddingEnd="12dp"
                    android:text="@string/system_status"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/source_wizard_row_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center_vertical"
                    android:paddingStart="47dp"
                    android:paddingEnd="12dp"
                    android:text="@string/settings"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Same untinted, divider-free footer as other wizard stages. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/finishBack"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/source_wizard_companion_back"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView
            android:id="@+id/finishDone"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/source_wizard_finish_done"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
