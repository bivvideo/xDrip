<?xml version="1.0" encoding="utf-8"?>
<!-- SW-014: named Companion App mandatory permission and reused stability rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:text="@string/source_wizard_permissions_title"
        android:textSize="22sp"
        android:textColor="?android:attr/textColorPrimary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/source_wizard_row_divider" />

    <ScrollView
        android:id="@+id/permissionsBodyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/source_wizard_permissions_required"
                android:textAllCaps="true"
                android:letterSpacing="0.045"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="66dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/source_wizard_plate_single">
                <ImageView
                    android:id="@+id/permissionsListenerIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/source_wizard_readiness_unknown"
                    android:contentDescription="@string/source_wizard_readiness_state_unknown" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/source_wizard_readiness_notification_listener"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />
                    <TextView
                        android:id="@+id/permissionsListenerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:id="@+id/permissionsListenerAction"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:background="@drawable/source_wizard_readiness_action"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionsListenerGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:layout_marginBottom="12dp"
                android:text="@string/source_wizard_readiness_section_stability"
                android:textAllCaps="true"
                android:letterSpacing="0.045"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />
            <LinearLayout
                android:id="@+id/permissionsStabilityRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/source_wizard_plate_single" />
        </LinearLayout>
    </ScrollView>

    <!-- Actions on the same background, without the old tinted footer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/permissionsBack"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/source_wizard_companion_back"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView
            android:id="@+id/permissionsProceed"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/source_wizard_companion_continue"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
